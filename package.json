{
  "name": "decky-live-caption",
  "version": "0.1.0-alpha.2",
  "private": true,
  "description": "Automatic region OCR and non-interactive subtitles for Decky Loader",
  "author": "irumeria",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
